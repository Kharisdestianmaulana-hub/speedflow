{
  "manifest_version": 3,
  "name": "SpeedFlow Download Interceptor",
  "version": "1.0.0",
  "description": "Seamlessly intercepts browser downloads and accelerates them with SpeedFlow Desktop Download Manager.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-32.png",
    "default_title": "SpeedFlow Downloader"
  },
  "permissions": [
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19760/*",
    "http://localhost:19760/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "speedflow@speedflow.app",
      "strict_min_version": "109.0"
    }
  }
}
