export global ThemeTokens {
    // Flat Pane Radius (Clean 2px flat corners)
    out property <length> radius-none: 0px;
    out property <length> radius-sm: 2px;
    out property <length> radius-md: 2px;
    out property <length> radius-lg: 2px;
    out property <length> radius-full: 2px;

    // Spacing Scale
    out property <length> space-1: 2px;
    out property <length> space-2: 4px;
    out property <length> space-3: 8px;
    out property <length> space-4: 12px;
    out property <length> space-5: 16px;
    out property <length> space-6: 20px;
    out property <length> space-8: 24px;
    out property <length> space-10: 32px;
    out property <length> space-12: 40px;

    // Typography Scale
    out property <length> font-display: 22px;
    out property <length> font-h1: 18px;
    out property <length> font-h2: 15px;
    out property <length> font-h3: 13px;
    out property <length> font-body-lg: 13px;
    out property <length> font-body: 12px;
    out property <length> font-body-sm: 11px;
    out property <length> font-caption: 10px;
}
